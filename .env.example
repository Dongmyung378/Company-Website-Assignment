# Copy to the repository root .env, outside public/. Never commit the real .env.
# Create a restricted runtime account; root and empty runtime credentials are rejected.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=company_db
DB_USER=company_app
# Fill in a long unique runtime password before provisioning the DB user.
DB_PASSWORD=

# Used only by trusted CLI setup/migration entrypoints, never by web requests.
DB_SETUP_USER=company_setup
# Fill in the existing, separate setup/admin account password.
DB_SETUP_PASSWORD=

# Use your exact public HTTPS origin in production. HTTP localhost works in development.
APP_ORIGIN=http://127.0.0.1:8000
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
# Optional absolute private log destination outside public/. Default: var/php-error.log.
# APP_ERROR_LOG=D:/private/company/php-error.log
